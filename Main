import math
from collections import Counter

# ==================================================
# 1. 建立城市資料
# 每筆資料格式：
# (x, y, label, trust, area)
#
# x, y   : 居民的位置
# label  : 該居民選擇的出口 ('A', 'B', 'C')
# trust  : 該居民的可信度
# area   : 所在區域
# ==================================================

city = [
    # ------------------------
    # 北區：大多是正確出口 A
    # ------------------------
    (1, 8, 'A', 0.9, 'North'),
    (2, 9, 'A', 0.9, 'North'),
    (3, 8, 'A', 0.9, 'North'),
    (2, 7, 'A', 0.9, 'North'),

    # ------------------------
    # 中區：混合區，但大多偏向 A
    # ------------------------
    (4, 6, 'A', 0.7, 'Middle'),
    (5, 5, 'A', 0.7, 'Middle'),
    (6, 6, 'B', 0.7, 'Middle'),
    (5, 7, 'A', 0.7, 'Middle'),

    # ------------------------
    # 南區：偏差區，彼此很近，但大多選錯 C
    # 這就是老師說的 bias zone
    # ------------------------
    (6, 4, 'C', 0.3, 'South'),
    (7, 4, 'C', 0.3, 'South'),
    (6, 3, 'C', 0.3, 'South'),
    (7, 3, 'C', 0.3, 'South'),
    (8, 4, 'C', 0.3, 'South'),
]

# 調查員（你）的位置：故意放在中區與南區交界
query = (5.8, 4.8)


# ==================================================
# 2. 距離函式：歐幾里得距離 L2
# ==================================================
def euclidean(p1, p2):
    return math.sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)


# ==================================================
# 3. 傳統 KNN
# 規則：
#   1. 找最近的 K 個鄰居
#   2. 用多數決決定結果
# ==================================================
def knn_predict(data, query_point, k=3):
    distances = []

    for person in data:
        x, y, label, trust, area = person
        d = euclidean((x, y), query_point)
        distances.append((d, label, trust, area, x, y))

    # 依距離排序，越近排前面
    distances.sort(key=lambda x: x[0])

    # 取最近的 K 個
    neighbors = distances[:k]

    # 多數決
    votes = [n[1] for n in neighbors]
    result = Counter(votes).most_common(1)[0][0]

    return result, neighbors


# ==================================================
# 4. 改良版：Trust-aware Weighted KNN
# 規則：
#   1. 找最近的 K 個鄰居
#   2. 每個鄰居不再「一票等值」
#   3. 權重 = trust / distance
#   4. 最後看哪個 label 的總分最高
# ==================================================
def trust_weighted_knn(data, query_point, k=3):
    distances = []

    for person in data:
        x, y, label, trust, area = person
        d = euclidean((x, y), query_point)
        distances.append((d, label, trust, area, x, y))

    # 依距離排序
    distances.sort(key=lambda x: x[0])

    # 取最近的 K 個鄰居
    neighbors = distances[:k]

    # 用分數累加，而不是單純投票
    score = {}

    for d, label, trust, area, x, y in neighbors:
        # 距離越近，分數越高；trust 越高，分數越高
        weight = trust / (d + 1e-6)   # 加 1e-6 避免除以 0
        score[label] = score.get(label, 0) + weight

    # 取得分最高者
    result = max(score, key=score.get)

    return result, neighbors, score


# ==================================================
# 5. 顯示鄰居資訊
# 讓你可以清楚知道模型到底參考了誰
# ==================================================
def print_neighbors(neighbors):
    for i, n in enumerate(neighbors, 1):
        d, label, trust, area, x, y = n
        print(
            f"鄰居{i}: 區域={area}, 座標=({x},{y}), "
            f"選擇={label}, trust={trust}, 距離={d:.2f}"
        )


# ==================================================
# 6. 主程式：比較 K = 1, 3, 5
# ==================================================
def main():
    print("查詢點（調查員）位置：", query)

    print("\n" + "=" * 60)
    print("一、傳統 KNN 模擬")
    print("=" * 60)

    for k in [1, 3, 5]:
        result, neighbors = knn_predict(city, query, k)

        print(f"\n--- K = {k} ---")
        print_neighbors(neighbors)
        print("傳統 KNN 預測結果：", result)

    print("\n" + "=" * 60)
    print("二、改良版 Trust-aware Weighted KNN")
    print("=" * 60)

    for k in [1, 3, 5, 7]:
        result, neighbors, score = trust_weighted_knn(city, query, k)

        print(f"\n--- K = {k} ---")
        print_neighbors(neighbors)
        print("各出口加權分數：")
        for label, s in score.items():
            print(f"  {label}: {s:.4f}")
        print("改良版 KNN 預測結果：", result)


if __name__ == "__main__":
    main()
